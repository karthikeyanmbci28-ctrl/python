def print_formatted(number):
    # Calculate the width needed based on the binary representation of 'number'
    width = len(bin(number)[2:])
    
    for i in range(1, number + 1):
        # Generate the four string representations
        dec = str(i)
        octal = oct(i)[2:]
        hex_val = hex(i)[2:].upper()
        binary = bin(i)[2:]
        
        # Print each value right-justified to 'width'
        print(f"{dec.rjust(width)} {octal.rjust(width)} {hex_val.rjust(width)} {binary.rjust(width)}")
