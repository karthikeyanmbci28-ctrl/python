# Enter your code here. Read input from STDIN. Print output to STDOUT
from itertools import combinations

# Read input
n = int(input())
letters = input().split()
k = int(input())

# 1. Generate all possible index combinations
# We use indices (0, 1, 2...) to handle duplicate letters correctly
all_combinations = list(combinations(range(n), k))

# 2. Filter combinations that contain at least one index where the letter is 'a'
# Find the indices where 'a' occurs
indices_of_a = [i for i, char in enumerate(letters) if char == 'a']

count = 0
for combo in all_combinations:
    # Check if any index in the current combination points to an 'a'
    if any(index in indices_of_a for index in combo):
        count += 1

# 3. Calculate and format probability
probability = count / len(all_combinations)
print(f"{probability:.4f}")
