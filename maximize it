# Enter your code here. Read input from STDIN. Print output to STDOUT
from itertools import product

# Read K and M
k, m = map(int, input().split())

# Read the lists, ignoring the first element (size N_i) of each line
lists = []
for _ in range(k):
    # input().split()[1:] skips the count of elements and takes the actual numbers
    lists.append(list(map(int, input().split()[1:])))

# Generate all possible combinations (cartesian product)
# Each combination 'c' is a tuple containing one element from each list
max_val = 0
for combination in product(*lists):
    # Calculate sum of squares modulo M
    current_sum = sum(x**2 for x in combination) % m
    
    # Update max_val if current_sum is larger
    if current_sum > max_val:
        max_val = current_sum

print(max_val)
